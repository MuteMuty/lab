{
  "name": "lab-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-data.ts",
    "bundle": "esbuild web/app.ts --bundle --minify --format=esm --target=es2022 --outfile=public/app.js",
    "typecheck": "tsc -p . && tsc -p tests",
    "test": "npm run typecheck && node --test",
    "playtest": "node tests/playtest.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "playwright": "1.52.0",
    "typescript": "5.8.3",
    "wrangler": "4.160.0"
  }
}
